# Solana memecoin bot — copy to .env

WALLET_PRIVATE_KEY=
HELIUS_API_KEY=
BIRDEYE_API_KEY=
TWITTER_BEARER_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Live auto-buy (recommended)
PAPER_TRADE=false
ALERTS_ONLY=false
AUTO_BUY=true
ENABLE_COPY_TRADING=true
ENABLE_SCANNER=true
TWITTER_AUTO_BUY=true

# Optional Railway PostgreSQL
DATABASE_URL=

# HERMES Council — 7 agents, 4/7 approve
USE_MEME_COUNCIL=true
MEME_COUNCIL_MIN=4
COPY_COUNCIL_MIN=4
COPY_USE_COUNCIL=true
TWITTER_USE_COUNCIL=true
WHALE_MAX_TOP1_PCT=25
WHALE_MAX_TOP5_PCT=55

# Speed tuning
SCAN_INTERVAL_SECONDS=15
SCAN_MIN_SCORE=82
SCAN_MIN_BUY_PRESSURE=55
SCAN_MIN_VOLUME_24H=200000
SCAN_GMGN_TRENDING_BUY=false
SCAN_GMGN_SIGNALS_BUY=true
MEME_COUNCIL_MIN=5
COPY_COUNCIL_MIN=4
WALLET_POLL_INTERVAL_SECONDS=12
BUY_SLIPPAGE_BPS=500
COPY_BUY_SLIPPAGE_BPS=800
BUY_PRIORITY_FEE_LAMPORTS=300000

ENABLE_TWITTER_TRACKER=true
TWITTER_CALLERS=
DAILY_PROFIT_TARGET_USD=50
